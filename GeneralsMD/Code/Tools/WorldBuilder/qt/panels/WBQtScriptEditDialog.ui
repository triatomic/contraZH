        </item>
        <item>
         <widget class="QToolButton" name="subroutineChip">
          <property name="text">
           <string>Subroutine</string>
          </property>
          <property name="toolTip">
           <string>Make this script usable by teams; read the manual for more info.</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QToolButton" name="oneShotChip">
          <property name="text">
           <string>Deactivate upon success</string>
          </property>
          <property name="toolTip">
           <string>The script disables itself after completing successfully.</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="Line" name="flagsSep">
          <property name="orientation">
           <enum>Qt::Vertical</enum>
          </property>

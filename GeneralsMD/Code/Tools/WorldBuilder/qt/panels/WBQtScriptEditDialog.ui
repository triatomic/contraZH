<ui version="4.0">
 <class>WBQtScriptEditDialog</class>
 <widget class="QDialog" name="WBQtScriptEditDialog">
  <layout class="QVBoxLayout" name="rootLayout" stretch="0,1,0,0">
   <item>
    <widget class="QFrame" name="propsStrip">
     <property name="frameShape">
      <enum>QFrame::StyledPanel</enum>
     </property>
     <layout class="QVBoxLayout" name="propsLayout">
      <item>
       <layout class="QHBoxLayout" name="nameRow">
        <item>
         <widget class="QLabel" name="nameLabel">
          <property name="text">
           <string>Name</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLineEdit" name="nameEdit"/>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="flagsRow">
        <item>
         <widget class="QToolButton" name="activeChip">
          <property name="text">
           <string>Active</string>
          </property>
          <property name="toolTip">
           <string>Script is Active</string>
          </property>
